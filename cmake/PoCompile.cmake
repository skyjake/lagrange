# Parses .po files and generates binary language strings like app/po/compile.py, except
# that strings are terminated with 0x01 instead of NUL (CMake 3.15 cannot write NULs).
#
# Standalone usage: cmake -DPO_DIR=<dir> -DOUT_DIR=<dir> -DLANGS="en;fi;..." -P PoCompile.cmake

if (CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    cmake_minimum_required (VERSION 3.15)
endif ()
set (_po_script ${CMAKE_CURRENT_LIST_FILE})

# Characters that would break list handling are swapped with control codes while parsing.
string (ASCII 1 _po_sep)
string (ASCII 2 _po_semicolon)
string (ASCII 3 _po_lbracket)
string (ASCII 4 _po_rbracket)
string (ASCII 5 _po_backslash)
string (ASCII 6 _po_literal)
string (ASCII 11 _po_vtab)

function (_po_unquote out text)
    string (STRIP "${text}" _uq)
    if (NOT _uq MATCHES "^\"(.*)\"$")
        message (FATAL_ERROR "invalid quoted string: ${text}")
    endif ()
    set (_uq "${CMAKE_MATCH_1}")
    string (REPLACE "${_po_backslash}${_po_backslash}" "${_po_literal}" _uq "${_uq}")
    string (REPLACE "${_po_backslash}\"" "\"" _uq "${_uq}")
    string (REPLACE "${_po_backslash}n" "\n" _uq "${_uq}")
    string (REPLACE "${_po_backslash}r" "\r" _uq "${_uq}")
    string (REPLACE "${_po_backslash}t" "\t" _uq "${_uq}")
    string (REPLACE "${_po_backslash}v" "${_po_vtab}" _uq "${_uq}")
    string (REPLACE "${_po_literal}" "${_po_backslash}" _uq "${_uq}")
    set (${out} "${_uq}" PARENT_SCOPE)
endfunction ()

# Result is a list of "id<sep>str" entries.
function (_po_parse out src)
    file (READ "${src}" content)
    string (REPLACE "\r" "" content "${content}")
    string (REPLACE "\\" "${_po_backslash}" content "${content}")
    string (REPLACE ";" "${_po_semicolon}" content "${content}")
    string (REPLACE "[" "${_po_lbracket}" content "${content}")
    string (REPLACE "]" "${_po_rbracket}" content "${content}")
    string (REPLACE "\n" ";" lines "${content}")
    set (messages)
    set (isMulti NO)
    set (msgId "")
    set (msgStr "")
    set (msgIndex "")
    foreach (line IN LISTS lines)
        string (STRIP "${line}" line)
        if (isMulti)
            if (NOT line MATCHES "^\"")
                if (NOT msgId STREQUAL "")
                    list (APPEND messages "${msgId}${_po_sep}${msgIndex}${_po_sep}${msgStr}")
                endif ()
                set (isMulti NO)
            else ()
                _po_unquote (part "${line}")
                string (APPEND msgStr "${part}")
            endif ()
        endif ()
        if (line MATCHES "^msgid_plural(.*)")
            _po_unquote (msgId "${CMAKE_MATCH_1}")
        elseif (line MATCHES "^msgid (.*)")
            _po_unquote (msgId "${CMAKE_MATCH_1}")
        elseif (line MATCHES "^msgstr(.*)")
            set (rest "${CMAKE_MATCH_1}")
            if (rest MATCHES "^${_po_lbracket}([0-9])${_po_rbracket}(.*)")
                set (msgIndex ${CMAKE_MATCH_1})
                set (rest "${CMAKE_MATCH_2}")
            else ()
                set (msgIndex "")
            endif ()
            if (rest MATCHES " \"\"$")
                set (isMulti YES)
                set (msgStr "")
            else ()
                _po_unquote (msgStr "${rest}")
                if (NOT msgId STREQUAL "")
                    list (APPEND messages "${msgId}${_po_sep}${msgIndex}${_po_sep}${msgStr}")
                endif ()
            endif ()
        endif ()
    endforeach ()
    if (isMulti AND NOT msgId STREQUAL "")
        list (APPEND messages "${msgId}${_po_sep}${msgIndex}${_po_sep}${msgStr}")
    endif ()
    # Apply plural indices to ids.
    set (result)
    foreach (msg IN LISTS messages)
        string (FIND "${msg}" "${_po_sep}" pos)
        string (SUBSTRING "${msg}" 0 ${pos} msgId)
        math (EXPR pos "${pos} + 1")
        string (SUBSTRING "${msg}" ${pos} -1 msg)
        string (FIND "${msg}" "${_po_sep}" pos)
        string (SUBSTRING "${msg}" 0 ${pos} msgIndex)
        math (EXPR pos "${pos} + 1")
        string (SUBSTRING "${msg}" ${pos} -1 msgStr)
        if (NOT msgIndex STREQUAL "")
            string (REGEX REPLACE ".$" "${msgIndex}" msgId "${msgId}")
        endif ()
        list (APPEND result "${msgId}${_po_sep}${msgStr}")
    endforeach ()
    set (${out} "${result}" PARENT_SCOPE)
endfunction ()

function (_po_write dst messages)
    list (SORT messages)
    list (JOIN messages "${_po_sep}" data)
    if (NOT data STREQUAL "")
        string (APPEND data "${_po_sep}")
    endif ()
    string (REPLACE "${_po_semicolon}" ";" data "${data}")
    string (REPLACE "${_po_lbracket}" "[" data "${data}")
    string (REPLACE "${_po_rbracket}" "]" data "${data}")
    string (REPLACE "${_po_backslash}" "\\" data "${data}")
    file (WRITE "${dst}" "${data}")
endfunction ()

function (_po_compile_lang src dst baseMessages)
    _po_parse (lang "${src}")
    foreach (msg IN LISTS lang)
        string (FIND "${msg}" "${_po_sep}" pos)
        string (SUBSTRING "${msg}" 0 ${pos} msgId)
        set ("_have_${msgId}" YES)
    endforeach ()
    # Take missing strings from the base language.
    set (missing 0)
    foreach (msg IN LISTS baseMessages)
        string (FIND "${msg}" "${_po_sep}" pos)
        string (SUBSTRING "${msg}" 0 ${pos} msgId)
        string (REGEX REPLACE "..$" "" stem "${msgId}")
        if (NOT DEFINED "_have_${msgId}" AND NOT DEFINED "_plural_${stem}")
            math (EXPR missing "${missing} + 1")
            list (APPEND lang "${msg}")
        endif ()
    endforeach ()
    _po_write ("${dst}" "${lang}")
    if (CMAKE_SCRIPT_MODE_FILE AND missing GREATER 0)
        get_filename_component (langId "${src}" NAME_WE)
        message (STATUS "${langId}: ${missing} missing")
    endif ()
endfunction ()

# Only languages whose .bin is older than its .po or en.po are recompiled.
function (compile_lang_strings poDir outDir)
    set (stale)
    foreach (langId ${ARGN})
        set (dst "${outDir}/${langId}.bin")
        if ("${poDir}/${langId}.po" IS_NEWER_THAN "${dst}" OR
            "${poDir}/en.po" IS_NEWER_THAN "${dst}" OR
            "${_po_script}" IS_NEWER_THAN "${dst}")
            list (APPEND stale ${langId})
        endif ()
    endforeach ()
    if (NOT stale)
        return ()
    endif ()
    _po_parse (base "${poDir}/en.po")
    foreach (msg IN LISTS base)
        if (msg MATCHES "^([^${_po_sep}]*)\\.0${_po_sep}")
            set ("_plural_${CMAKE_MATCH_1}" YES)
        endif ()
    endforeach ()
    file (MAKE_DIRECTORY "${outDir}")
    foreach (langId IN LISTS stale)
        _po_compile_lang ("${poDir}/${langId}.po" "${outDir}/${langId}.bin" "${base}")
    endforeach ()
endfunction ()

if (CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    compile_lang_strings ("${PO_DIR}" "${OUT_DIR}" ${LANGS})
endif ()
