msgid "error.badstatus"
#msgstr "Unknown Status Code"
msgstr "Ukjent Tilstand Bod"

msgid "error.badstatus.msg"
#msgstr "The server responded with a status code that is not in the Gemini protocol specification. Maybe the server is malfunctioning."
msgstr "Verten svarte med eit tilstand bod som ikkje er innenfor tvillingvevets semjemål. Kanskje verten er vranginnstilt. "

msgid "error.openfile"
#msgstr "Failed to Open File"
msgstr "Misblømet å Opna Verket"

msgid "error.openfile.msg"
#msgstr "The requested file does not exist or is inaccessible. Please check the file path."
msgstr "Det førespurte verket finnest ikkje eller er utilgjengeleg. Vennlegst sjekk verk setjen."

msgid "error.badresource"
#msgstr "Invalid Resource"
msgstr "Ugyldig verk"

msgid "error.badresource.msg"
#msgstr "The requested resource does not exist."
msgstr "Det førespurte verket finnes ikkje."

msgid "error.unsupported.media"
#msgstr "Unsupported Content Type"
msgstr "Ustøtta Innhald Slag"

msgid "error.unsupported.media.msg"
#msgstr "The received content cannot be viewed with this application."
msgstr "Det mottatte innhaldet kan ikkje bli vist i dette verktøyet."

msgid "error.unsupported.protocol"
#msgstr "Unsupported Protocol"
msgstr "Ustøtta Semjemål"

msgid "error.unsupported.protocol.msg"
#msgstr "The requested protocol is not supported by this application."
msgstr "Det førespurte semjemålet er ikkje støtta av dette verktøyet."

msgid "error.badheader"
#msgstr "Invalid Header"
msgstr "Ugyldig Hovud"

msgid "error.badheader.msg"
#msgstr "The received header does not conform to the protocol specification. Perhaps the server is malfunctioning or does not support this protocol."
msgstr "Det mottatte hovudet tilpasser seg ikkje semjemålet. Kanskje verten er kråkemålet eller at den ikkje snakker semjemålet."

msgid "error.incompleteheader"
#msgstr "Incomplete Header"
msgstr "Ufullstendig Hovude"

msgid "error.incompleteheader.msg"
#msgstr "The server's response did not contain a complete header. Perhaps the server is malfunctioning, or you tried to contact a non-Gemini server."
msgstr "Vertens svar hadde ikkje eit fullstendig hovude. Kanskje verten er kråkemålet, eller at du røynet å antaka ein ikkje-tvillingvev vert."

msgid "error.badredirect"
#msgstr "Invalid Redirect"
msgstr "Ugyldig Ompeik"

msgid "error.badredirect.msg"
#msgstr "The server responded with a redirect but did not provide a valid destination URL. Perhaps the server is malfunctioning."
msgstr "Verten svarte med eit ompeik, men gav ikkje ein gyldig stemne. Kanskje verten er vrangferda?"

msgid "error.schemeredirect"
#msgstr "Scheme-Changing Redirect"
msgstr "Setnad-Endring Ompeik"

msgid "error.schemeredirect.msg"
#msgstr "The server attempted to redirect us to a URL whose scheme is different than the originating URL's scheme. Here is the link so you can open it manually if appropriate."
msgstr "Verten røynet å ompeika oss til eit stemne der setnad var ulikt det opphavlege stemne setnaden. Her er eit peik som du kan opne handleg om det skulle passe."

msgid "error.manyredirects"
#msgstr "Too Many Redirects"
msgstr "For Mange Ompeik"

msgid "error.manyredirects.msg"
#msgstr "You may be stuck in a redirection loop. The next redirected URL is below if you want to continue manually."
msgstr "Du er kanskje surret inn i eit ompeik kvervel. Det neste ompeik stemnet er under om du har lyst til å halda fram handleg."

msgid "error.tls"
#msgstr "Network/TLS Failure"
msgstr "Vev/ TLS Misbløm"

msgid "error.tls.msg"
#msgstr "Failed to communicate with the server."
msgstr "Misblømet å talemåla med verten."

msgid "error.certexpired"
#msgstr "Expired Certificate"
msgstr "Utgått Nøkkelkort"

msgid "error.certexpired.msg"
#msgstr "Connection to the server was cancelled because its TLS certificate has expired."
msgstr "Kopling til vert blei avbrutt på grunn av nøkkelkortet (TLS) har utgått ."

msgid "error.proxyexpired"
#msgstr "Expired Proxy Certificate"
msgstr "Utgått Ombod Nøkkelkort"

msgid "error.proxyexpired.msg"
#msgstr "The connection was cancelled because the proxy server's TLS certificate has expired."
msgstr "Koplingen blei avbrutt fordi ombud verten's nøkkelkort (TLS) har utgått ."

msgid "error.certverify"
#msgstr "Untrusted Server"
msgstr "Utrygg vert"

msgid "error.certverify.msg"
#msgstr "Connection to the server was cancelled because its TLS certificate does not match the one we trust. Please check if the server has announced a certificate change. If not, it is possible that a malicious third party is masquerading as the server you tried to reach.\n\nThe certificate can be marked as trusted in Page Information."
msgstr "Kopling til verten var avbrutt fordi dens nøkkelkort (TLS) ikkje samsvarer med dei me stoler på. Vennlegst sjekk om verten har omtalt ein nøkkelkort endring. Viss ikkje, så er det mogleg at ein ondsinnet tredjepart har tilslører seg som verten du røyner å gjesta. \n\nNøkkelkortet kan bli markert som trygg i Sted Opplysningar"

msgid "error.proxyverify"
#msgstr "Untrusted Proxy"
msgstr "Utrygt Ombod"

msgid "error.proxyverify.msg"
#msgstr "Connection was cancelled because the proxy server's TLS certificate does not match the one we trust.\n\nThe proxy server's certificate can be marked as trusted in Page Information."
msgstr "Koplingen blei avbrutt fordi ombods vertens nøkkelkort (TLS) ikkje samsvarer med den me stoler på.\n\nOmbods verten's nøkkelkort kan bli markert som trygg i Sted Opplysningar."

msgid "error.temporary"
#msgstr "Temporary Failure"
msgstr "Mellombels Misbløm"

msgid "error.temporary.msg"
#msgstr "The request has failed, but may succeed if you try again in the future."
msgstr "Førespurnaden har misblømet, men kan bløma om du røyner igjen."

msgid "error.unavail"
#msgstr "Server Unavailable"
msgstr "Vert Utilgjengeleg"

msgid "error.unavail.msg"
#msgstr "The server is unavailable due to overload or maintenance. Check back later."
msgstr "Verten er utilgjengeleg på grunn av overbyrde eller vedlikehald. Sjekk igjen seinare."

msgid "error.cgi"
#msgstr "CGI Error"
msgstr "CGI Misbløm"

msgid "error.cgi.msg"
#msgstr "Failure during dynamic content generation on the server. This may be due to malfunctioning serverside software."
msgstr "Misblømet ved brygging av tøyeleg innhald på verten. Dette kan vera på grunn av misferda vertsleg programvare."

msgid "error.proxy"
#msgstr "Proxy Error"
msgstr "Ombud Misbløm"

msgid "error.proxy.msg"
#msgstr "A proxy request failed because the server was unable to successfully complete a transaction with the remote host. Perhaps there are difficulties with network connectivity."
msgstr "Ein ombuds førespurnad misblømet på grunn av at verten ikkje var i stand til å blømt utføra eit samtak med den fjerne verten. Kanskje det er vanskelegdomar med vevets tilkopling. "

msgid "error.slowdown"
#msgstr "Slow Down"
msgstr "Saktna Ned"

msgid "error.slowdown.msg"
#msgstr "The server is rate limiting requests. Please wait…"
msgstr "Verten avgrenser førespurnadar. Vennlegst vent..."

msgid "error.permanent"
#msgstr "Permanent Failure"
msgstr "Støypt Misbløm"

msgid "error.permanent.msg"
#msgstr "Your request has failed and will fail in the future as well if repeated."
msgstr "Din førespurnad har misblømt og vil misbløma i igjen dersom gjenrøynt"

msgid "error.notfound"
#msgstr "Not Found"
msgstr "Ikkje funnen"

msgid "error.notfound.msg"
#msgstr "The requested resource could not be found at this time."
msgstr "Det førespurte verket kunne ikkje bli funnet på dette tidsodd."

msgid "error.gone"
#msgstr "Gone"
msgstr "Svunnen"

msgid "error.gone.msg"
#msgstr "The requested resource is no longer available."
msgstr "Det førespurte verket er ikkje lengre tilgjengeleg."

msgid "error.proxyrefusal"
#msgstr "Proxy Request Refused"
msgstr "Ombud Førespurnad Nekta"

msgid "error.proxyrefusal.msg"
#msgstr "The request was for a resource at a domain not served by the server and the server does not accept proxy requests."
msgstr "Førespurnaden var for eit verk frå eit sted utenfor vernaden, og verten godtek ikkje ombuds førespurnadar."

msgid "error.badrequest"
#msgstr "Bad Request"
msgstr "Dårleg Førespurnad"

msgid "error.badrequest.msg"
#msgstr "The server did not understand your request."
msgstr "Verten kunne ikkje skjøna din førespurnad."

msgid "error.cert.needed"
#msgstr "Certificate Required"
msgstr "Nøkkelkort Påkrevd"

msgid "error.cert.needed.msg"
#msgstr "Access to the requested resource requires identification via a client certificate."
msgstr "Tilgang til det førespurte verket krever å sjela seg gjennom eit nøkkelkort."

msgid "error.cert.auth"
#msgstr "Certificate Not Authorized"
msgstr "Nøkkelkort Ikkje Løyven"

msgid "error.cert.auth.msg"
#msgstr "The provided client certificate is valid but is not authorized for accessing the requested resource."
msgstr "Det gitte gjeste nøkkelkortet er gyldig, men er ikkje løyven for å få tilgang til det førespurte verket."

msgid "error.cert.invalid"
#msgstr "Invalid Certificate"
msgstr "Ugyldig Nøkkelkort"

msgid "error.cert.invalid.msg"
#msgstr "The provided client certificate is expired or invalid."
msgstr "Det gitte gjeste nøkkelkortet har utgått eller er ugyldig."

msgid "error.ansi"
#msgstr "Terminal Emulation"
msgstr "Terminal Emulation"

msgid "error.ansi.msg"
#msgstr "This page may not be displayed correctly. It uses ANSI escape sequences to style text, which is only partially supported. You could try using a terminal emulator to view it."
msgstr "Denne siden kan ikkje bli vist riktig. Den bruker \"ANSI escape sequaneces\" for å steila skriften, som er berre delvis støttet. Du kan røyna å bruka \"terminal emulator\" for å sjå det."

msgid "error.glyphs"
#msgstr "Missing Glyphs"
msgstr "Manglandes Rissar"

msgid "error.glyphs.msg"
#msgstr "This page could not be displayed in full because some characters are missing. You can install additional fonts to fix this."
msgstr "Denne siden kunne ikkje bli vist fultt ut fordi nokre stavar mangler. Du kan innføre nye skriftslag for å bregna dette."

msgid "error.showutf8"
#msgstr "Autodetected UTF-8"
msgstr "Gjenkjente UTF-8"

msgid "error.showutf8.msg"
#msgstr "The media type of this page was not recognized but it is valid UTF-8 encoded text."
msgstr "Media typen av denne siden var ikkje gjenkjennbar, men er gyldig som UTF-8 kodet skrift. "

